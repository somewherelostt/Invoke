# ============================================
# INVOKE - Environment Configuration
# Copy this file to .env and fill in your values
# ============================================

# --- Whisper (faster-whisper transcription server) ---
WHISPER_HOST=http://127.0.0.1
WHISPER_PORT=8394
WHISPER_MODEL=tiny

# --- Ollama (local LLM) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:0.6b

# --- Composio (tool execution) ---
# Get your API key from https://app.composio.dev
COMPOSIO_API_KEY=

# --- App Settings ---
# Hotkey to trigger voice input (Alt+Space by default)
HOTKEY=Alt+Space

# Whether to auto-paste results after execution
AUTO_PASTE=true

# Whether to confirm before executing actions
CONFIRM_ACTIONS=true
